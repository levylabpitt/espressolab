# Copy this file to .env and fill in real values. Never commit .env.

# Local SQLite by default — zero setup, a file appears at espressolab.db.
# Tables are created automatically on first run either way.
DATABASE_URL=sqlite:///espressolab.db

# Swap to the lab Postgres server instead when you're ready:
# DATABASE_URL=postgresql://espressolab:changeme@lab-server.local:5432/espressolab

# Decaid's local API on this same Windows PC
DECAID_HOST=localhost
DECAID_REST_PORT=8080
DECAID_WS_PORT=8080
DECAID_WEBUI_PORT=3000

# Portal web server (what the touchscreen browser points at)
PORTAL_HOST=0.0.0.0
PORTAL_PORT=5000

# Minutes of inactivity before the portal forgets the selected user and
# returns to the picker screen.
PORTAL_SESSION_IDLE_MINUTES=15

# Used to sign the "who's selected" cookie. Set this to a random string.
SECRET_KEY=change-me-to-something-random

# Passcode required to reach the /admin user-management page.
ADMIN_PASSWORD=change-me

# Set to DEBUG on the logger to see every raw shotState frame it receives
# (useful when a shot isn't logging and you need to see why).
LOG_LEVEL=INFO

# Optional: lets /admin's "Sync from Asana" button add/update lab members
# (name, email, photo) from an Asana project's member list. Generate a
# Personal Access Token at https://app.asana.com/0/developer-console.
# The project GID is the number in that project's URL.
ASANA_TOKEN=
ASANA_PROJECT_GID=
